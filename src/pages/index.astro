---
import EntryList from '../components/EntryList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listEntries } from '../lib/collections';
import { recentlyChanged } from '../lib/content';

const LISTED = 5;

const posts = (await listEntries('posts')).slice(0, LISTED);
const changed = recentlyChanged([
	...(await listEntries('notes')).map((entry) => ({ kind: 'notes' as const, entry, id: entry.id, data: entry.data })),
	...(await listEntries('docs')).map((entry) => ({ kind: 'docs' as const, entry, id: entry.id, data: entry.data })),
]).slice(0, LISTED);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="col prose">
		<h1>{SITE_TITLE}</h1>
		<p class="text-lg text-muted">
			Posts about networks and how they are put together, short notes, and the docs I keep for
			myself.
		</p>
	</section>
	{
		posts.length > 0 && (
			<section class="col">
				<h2>Latest posts</h2>
				<EntryList items={posts.map((entry) => ({ kind: 'posts', entry }))} />
			</section>
		)
	}
	{
		changed.length > 0 && (
			<section class="col">
				<h2>Recently updated notes and docs</h2>
				<EntryList items={changed} showKind />
			</section>
		)
	}
</BaseLayout>
