---
import EntryList from '../../components/EntryList.astro';
import { SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listEntries } from '../../lib/collections';

const entries = await listEntries('posts');
const items = entries.map((entry) => ({ kind: 'posts' as const, entry }));
---

<BaseLayout title={`Posts | ${SITE_TITLE}`} description="Posts about networks and how they are put together.">
	<section class="col prose">
		<h1>Posts</h1>
		<p class="text-lg text-muted">Posts about networks and how they are put together.</p>
	</section>
	{items.length > 0 ? <EntryList items={items} /> : <p class="text-muted">Nothing here yet.</p>}
</BaseLayout>
