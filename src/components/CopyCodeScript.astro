<script>
	const COPIED_FEEDBACK_MS = 2000;

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
		const code = button.closest('.codeblock-frame')?.querySelector('pre');
		const label = button.querySelector<HTMLElement>('.visually-hidden');
		if (!code || !label) continue;
		const copyLabel = label.textContent;
		button.dataset.ready = '';
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(code.textContent ?? '');
			button.dataset.copied = '';
			label.textContent = button.dataset.copiedLabel ?? copyLabel;
			setTimeout(() => {
				delete button.dataset.copied;
				label.textContent = copyLabel;
			}, COPIED_FEEDBACK_MS);
		});
	}
</script>
