---
import AppearanceControl from './AppearanceControl.svelte';
import NavLink from '../kandan/components/NavLink.svelte';
import { SITE_TITLE } from '../consts';

const SECTIONS = [
	{ href: '/posts/', label: 'Posts' },
	{ href: '/notes/', label: 'Notes' },
	{ href: '/docs/', label: 'Docs' },
	{ href: '/about/', label: 'About' },
] as const;

const { pathname } = Astro.url;
---

<header class="surface border-b">
	<div class="page-wrap">
		<div class="row items-center justify-between wrap py-3">
			<a href="/" class="display text-lg weight-semibold">{SITE_TITLE}</a>
			<nav class="row items-center wrap gap-1" aria-label="Main">
				{
					SECTIONS.map(({ href, label }) => (
						<NavLink href={href} current={pathname.startsWith(href)}>
							{label}
						</NavLink>
					))
				}
				<AppearanceControl client:idle />
			</nav>
		</div>
	</div>
</header>
